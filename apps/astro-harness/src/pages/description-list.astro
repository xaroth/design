---
import Harness from '../layouts/Harness.astro'
import { DescriptionList, DescriptionListGroup, DescriptionListGroups } from '@xaroth.nl/design/astro'

const details = [
  { term: 'Published', value: '14 Mar 2026' },
  { term: 'Read time', value: '6 min' },
  { term: 'Author', value: 'Xaroth Brook' },
]
const links = [
  { term: 'GitHub', value: 'github.com/xaroth' },
  { term: 'Email', value: 'hello@xaroth.nl' },
  { term: 'EVE', value: 'Xaroth Brook' },
]
const now = [
  { term: 'Reading', value: 'The Shadow Rising' },
  { term: 'Playing', value: 'a mono-black Commander deck' },
  { term: 'Building', value: 'a design system for two sites' },
]
const stats = [
  { term: 'Region', value: 'The Forge' },
  { term: 'Security', value: '0.9' },
]
const changed = [
  { term: 'Total DPS', value: '1.84M', change: { amount: '+12.4%', effect: 'better' as const } },
  { term: 'Hit Damage', value: '48,210' },
  { term: 'Mana Cost', value: '14', change: { amount: '-4', effect: 'better' as const } },
  { term: 'Chaos Resistance', value: '-12%', change: { amount: '-6%', effect: 'worse' as const } },
]
const sheet = [
  { title: 'Offence', items: changed.slice(0, 3) },
  { title: 'Defences', items: details },
  { title: 'Resistances', items: [changed[3], ...stats] },
]
const box = 'display: grid; gap: 12px; align-content: start'
---

<Harness title="Description list">
  {() => (
    <div style="padding: 0 32px; display: grid; gap: 48px; grid-template-columns: repeat(auto-fill, minmax(300px, 360px))">
      <div style={box}>
        <p class="x-label">Inline, dividers</p>
        <DescriptionList items={details} layout="inline" dividers />
      </div>
      <div style={box}>
        <p class="x-label">Inline</p>
        <DescriptionList items={details} layout="inline" />
      </div>
      <div style={box}>
        <p class="x-label">Columns, links</p>
        <DescriptionList items={links} layout="columns">
          <a slot="value-0" href="https://github.com/xaroth">github.com/xaroth</a>
          <a slot="value-1" href="mailto:hello@xaroth.nl">hello@xaroth.nl</a>
          <a slot="value-2" href="#">Xaroth Brook</a>
        </DescriptionList>
      </div>
      <div style={box}>
        <p class="x-label">Columns</p>
        <DescriptionList items={now} layout="columns" />
      </div>
      <div style={box}>
        <p class="x-label">Stacked</p>
        <DescriptionList items={stats} />
      </div>
      <div style={box}>
        <p class="x-label">Stacked, dividers</p>
        <DescriptionList items={stats} dividers />
      </div>
      <div style={box}>
        <p class="x-label">Better and worse changes</p>
        <DescriptionList items={changed} layout="inline" dividers />
      </div>
      <div style={box}>
        <p class="x-label">Striped</p>
        <DescriptionList items={details} layout="inline" striped />
      </div>
      <div style={`${box}; grid-column: 1 / -1; max-width: 760px`}>
        <p class="x-label">Groups in columns</p>
        <DescriptionListGroups layout="columns">
          {sheet.map((group) => (
            <DescriptionListGroup title={group.title}>
              <DescriptionList items={group.items} layout="inline" dividers />
            </DescriptionListGroup>
          ))}
        </DescriptionListGroups>
      </div>
      <div style={box}>
        <p class="x-label">Comfortable area</p>
        <div class="x-density-comfortable">
          <DescriptionList items={details} layout="inline" dividers />
        </div>
      </div>
      <div style={box}>
        <p class="x-label">Dense area</p>
        <div class="x-density-dense">
          <DescriptionList items={details} layout="inline" dividers />
        </div>
      </div>
    </div>
  )}
</Harness>
