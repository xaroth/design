---
import './equipment-slot.scss'
import type { HTMLAttributes } from 'astro/types'
import {
  equipmentSlotClass,
  equipmentSlotClasses as c,
  equipmentSlotLinkAttrs,
  isEmptySlotContent,
  type EquipmentSlotHeadingLevel,
} from './index.ts'

type Props = Omit<HTMLAttributes<'li'>, 'class'> & {
  class?: string
  /** The slot's name, for example "Helmet". The `label` slot takes markup. */
  label?: string
  headingLevel?: EquipmentSlotHeadingLevel
  /** Makes the item, or the empty label, a link that chooses the slot, as in a list beside a detail view. */
  href?: string
  /** The slot is the chosen one. Marked on the link when there is one. */
  current?: boolean
  /** Shown when the slot has no item. The `emptyLabel` slot takes markup. */
  emptyLabel?: string
}

const { label, headingLevel = 3, href, current, emptyLabel = 'Empty', class: className, slot: _slot, ...rest } = Astro.props
const Heading = `h${headingLevel}` as const
// Rendered first, so a slot given `{item && <ItemCard />}` without an item counts as empty.
const children = Astro.slots.has('default') ? await Astro.slots.render('default') : undefined
const empty = isEmptySlotContent(children?.trim())
---

<li {...rest} class={equipmentSlotClass({ empty, current, className })}>
  <div class={c.head}>
    <Heading class={c.label}><slot name="label">{label}</slot></Heading>
    {
      Astro.slots.has('actions') && (
        <div class={c.actions}>
          <slot name="actions" />
        </div>
      )
    }
  </div>
  <div class={c.body}>
    {
      href != null ? (
        <a class={c.link} {...equipmentSlotLinkAttrs(href, current)}>
          {
            empty ? (
              <p class={c.empty}>
                <slot name="emptyLabel">{emptyLabel}</slot>
              </p>
            ) : (
              <Fragment set:html={children} />
            )
          }
        </a>
      ) : empty ? (
        <p class={c.empty}>
          <slot name="emptyLabel">{emptyLabel}</slot>
        </p>
      ) : (
        <Fragment set:html={children} />
      )
    }
  </div>
</li>
